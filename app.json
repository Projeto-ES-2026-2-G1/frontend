{
  "expo": {
    "name": "simplimei",
    "slug": "simplimei",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo-simplimei.png",
    "scheme": "simplimei",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/logo-simplimei.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#00412E",
        "foregroundImage": "./assets/images/logo-simplimei.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.simplimei.simplimei"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/logo-simplimei.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#00412E",
          "image": "./assets/images/logo-simplimei.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e3c24251-09a4-4125-b6c2-4343de977edd"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/e3c24251-09a4-4125-b6c2-4343de977edd"
    }
  }
}
